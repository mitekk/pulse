# Dependencies
node_modules/
**/node_modules/

# Build output
dist/
build/
**/dist/
**/build/
*.tsbuildinfo

# Env / secrets (never commit real env files)
.env
.env.*
!.env.example

# Test / coverage artifacts
coverage/
**/coverage/
playwright-report/
test-results/
blob-report/
.nyc_output/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Editor / OS
.DS_Store
.idea/
*.swp
.vscode/*
!.vscode/extensions.json

# Local data volumes (if ever bind-mounted)
pgdata/
redis-data/
minio-data/

# Playwright E2E runtime artifacts (regenerated per run)
tests/e2e/.auth/
playwright-report/
test-results/
tests/node_modules
