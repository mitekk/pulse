# ---------------------------------------------------------------------------
# Example environment for the microblogging platform stack.
# Copy to `.env` and fill real values. NEVER commit a real .env.
# The backend agent will extend/finalize these during Step 2.
# ---------------------------------------------------------------------------

# --- Core ---
NODE_ENV=development
API_PORT=3000
WEB_PORT=5173
API_BASE_URL=http://localhost:3000
WEB_ORIGIN=http://localhost:5173            # CORS allow-list entry

# --- PostgreSQL ---
DB_HOST=db
DB_PORT=5432
DB_NAME=tweeter
DB_USER=tweeter
DB_PASSWORD=change_me
DATABASE_URL=postgres://tweeter:change_me@db:5432/tweeter

# --- Redis (cache + timeline zsets + pub/sub + BullMQ) ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379

# --- Auth ---
JWT_ACCESS_SECRET=change_me_access_secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=change_me_refresh_secret
JWT_REFRESH_TTL=30d
REFRESH_COOKIE_NAME=tw_rt
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false                          # true in production (HTTPS)

# --- Object storage (S3-compatible / MinIO) for media pipeline ---
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_BUCKET=tweeter-media
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_PUBLIC_URL=http://localhost:9000/tweeter-media

# --- Feature thresholds / limits ---
CELEBRITY_FOLLOWER_THRESHOLD=10000
HOME_TIMELINE_CAP=800

# --- Frontend (Vite, must be prefixed VITE_) ---
VITE_API_BASE_URL=http://localhost:3000/api/v1
VITE_WS_URL=http://localhost:3000

# --- MinIO client config (backend agent additions) ---
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=tweeter-media

# --- Snowflake ID generator ---
SNOWFLAKE_MACHINE_ID=0          # 0–1023; change per deployed replica

# --- Ports (explicit) ---
PORT=3000
