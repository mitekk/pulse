{
  "name": "tweeter-e2e",
  "version": "1.0.0",
  "description": "Root workspace — Turborepo orchestration + Playwright E2E for the PULSE microblogging platform",
  "private": true,
  "packageManager": "npm@11.12.1",
  "engines": {
    "node": "24.x"
  },
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "dev": "turbo run dev",
    "test:e2e": "npx playwright test",
    "test:e2e:ui": "npx playwright test --ui",
    "test:e2e:headed": "npx playwright test --headed",
    "test:e2e:debug": "npx playwright test --debug"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "turbo": "^2.9.16"
  }
}
